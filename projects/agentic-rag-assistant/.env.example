# Copy to .env and fill in your key:  cp .env.example .env

# --- LLM ---------------------------------------------------------------------
# Required to run the agent and the eval harness.
ANTHROPIC_API_KEY=

# NOTE: this default is a placeholder. Set MODEL to a current Claude model id.
MODEL=claude-sonnet-5
TEMPERATURE=0

# --- Retrieval (local Chroma) ------------------------------------------------
DATA_DIR=data/knowledge
INDEX_DIR=.chroma
COLLECTION_NAME=acme_support
RETRIEVAL_K=4

# --- Guardrails --------------------------------------------------------------
MAX_INPUT_CHARS=4000

# --- Observability / tracing -------------------------------------------------
# Set true to emit a per-request span trace (latency, tokens, cost) to stderr.
TRACE_ENABLED=false
TRACE_SINK=stderr
# Token prices (USD per 1M tokens) used to estimate per-request cost.
# Set these to your model's actual rates.
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0
# Optional: native LangSmith tracing (LangChain/LangGraph read these directly).
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_API_KEY=
